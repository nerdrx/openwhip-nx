{
  "name": "openwhip-nx",
  "version": "1.3.1",
  "description": "Whip Claude into shape — NX fork for KDE Wayland and the Claude Code desktop app",
  "license": "MIT",
  "main": "main.js",
  "bin": {
    "openwhip": "bin/openwhip.js",
    "badclaude": "bin/openwhip.js"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "electron",
    "tray",
    "overlay",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GitFrog1111/OpenWhip.git"
  },
  "bugs": {
    "url": "https://github.com/GitFrog1111/OpenWhip/issues"
  },
  "homepage": "https://github.com/GitFrog1111/OpenWhip#readme",
  "files": [
    "main.js",
    "preload.js",
    "overlay.html",
    "sounds",
    "icon",
    "bin/openwhip.js",
    "bin/badclaude.js",
    "phrases.js"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "npm pack",
    "dist": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "dev.nerdrx.openwhip-nx",
    "productName": "OpenWhip NX",
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "sounds/**",
      "icon/**",
      "assets/**",
      "phrases.js"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "icon/Template.png",
      "category": "Utility"
    },
    "artifactName": "openwhip-nx-${version}-linux-x86_64.${ext}"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "author": "nerdrx"
}
